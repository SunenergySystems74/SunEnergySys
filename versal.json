{
  "projects": [
    {
      "src": "sunenergy/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "sunenergy/build"
      }
    },
    {
      "src": "backend/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/$1" },
    { "src": "/(.*)", "dest": "/sunenergy/$1" }
  ]
}
